{
  "name": "@meappy/openclaw-whatsapp-bridge",
  "version": "0.1.1",
  "description": "OpenClaw plugin: HTTP-in → WhatsApp-out bridge using the host bot's paired Baileys session.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meappy/openclaw-whatsapp-bridge.git"
  },
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "whatsapp",
    "baileys",
    "bridge"
  ],
  "main": "./dist/index.js",
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md"
  ],
  "scripts": {
    "build": "bun build index.ts --outdir dist --target node --format esm --external openclaw",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "openclaw": "*"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ]
  }
}
